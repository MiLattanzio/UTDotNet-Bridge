<Project>
  <Import Project="../Directory.Build.props" />
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Authors>Mi Lattanzio</Authors>
    <Copyright>Copyright (c) 2026 Mi</Copyright>
    <PackageProjectUrl>https://github.com/MiLattanzio/UTDotNet-Bridge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MiLattanzio/UTDotNet-Bridge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>UbuntuTouch;Lomiri;Maliit;Avalonia;Linux;input-method;clipboard</PackageTags>
    <PackageReleaseNotes>Adds ITextClipboard and managed ContentHubClipboard for native UTF-8 text exchange with Ubuntu Touch apps. The new TextClipboardBridge overload handles Copy/Cut/Paste, preserves undo and field constraints, and rejects late edits after selection or focus changes. Validated with 93 tests and bidirectional Qt/Morph exchange in confined Click 0.1.6 on Fairphone 5. Original phone menus and existing two-argument clipboard integration remain supported. Rich text, images, files and persistence across app exit/reboot are outside the validated scope.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Keep existing API summaries; undocumented members do not block preview packaging. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../packaging/nuget/README.md" Pack="true" PackagePath="/README.md" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
