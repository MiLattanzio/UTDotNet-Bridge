<Project>
  <Import Project="../Directory.Build.props" />
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Authors>Mi Lattanzio</Authors>
    <Copyright>Copyright (c) 2026 Mi</Copyright>
    <PackageProjectUrl>https://github.com/MiLattanzio/UTDotNet-Bridge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MiLattanzio/UTDotNet-Bridge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>UbuntuTouch;Lomiri;Maliit;Avalonia;Linux;input-method</PackageTags>
    <PackageReleaseNotes>Fixes selection of pending Maliit composition and preserves the input context when focus returns from a menu. Adds opt-in TextClipboardBridge and ClipboardTextWriter for bounded Copy/Cut writes with exact ownership checks and protection against delayed deletion. Validated with 70 tests and physical selection/Cut/Paste on Fairphone 5, Click 0.1.5. Native Qt clipboard interoperability remains unresolved.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Keep existing API summaries; undocumented members do not block preview packaging. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../packaging/nuget/README.md" Pack="true" PackagePath="/README.md" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
